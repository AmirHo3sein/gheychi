{
  "name": "@gheychi/user-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--require ./scripts/polyfill-set-methods.cjs\" nuxt build",
    "dev": "cross-env NODE_OPTIONS=\"--require ./scripts/polyfill-set-methods.cjs\" nuxt dev --port 3003",
    "generate": "cross-env NODE_OPTIONS=\"--require ./scripts/polyfill-set-methods.cjs\" nuxt generate",
    "preview": "cross-env NODE_OPTIONS=\"--require ./scripts/polyfill-set-methods.cjs\" nuxt preview",
    "postinstall": "nuxt prepare && ([ -f scripts/fix-shared-vue-instance.cjs ] && node scripts/fix-shared-vue-instance.cjs || true)",
    "test": "cross-env NODE_OPTIONS=\"--require ./scripts/polyfill-set-methods.cjs\" vitest run",
    "test:coverage": "cross-env NODE_OPTIONS=\"--require ./scripts/polyfill-set-methods.cjs\" vitest run --coverage",
    "test:e2e": "node e2e/prepare-db.cjs && playwright test",
    "typecheck": "cross-env NODE_OPTIONS=\"--require ./scripts/polyfill-set-methods.cjs\" nuxt typecheck"
  },
  "dependencies": {
    "@fontsource-variable/vazirmatn": "^5.2.8",
    "@nuxt/image": "^2.0.0",
    "@pinia/nuxt": "^0.11.3",
    "@sentry/vue": "^10.73.0",
    "@tailwindcss/vite": "^4.3.2",
    "jalaali-js": "^2.0.0",
    "leaflet": "^1.9.4",
    "markdown-it": "^14.1.0",
    "nuxt": "^4.4.8",
    "pinia": "^3.0.4",
    "tailwindcss": "^4.3.2",
    "vue-multiselect": "^3.5.0"
  },
  "devDependencies": {
    "@nuxt/test-utils": "^3.15.0",
    "@playwright/test": "^1.61.1",
    "@types/leaflet": "^1.9.21",
    "@types/markdown-it": "^14.1.2",
    "@vite-pwa/nuxt": "^1.1.1",
    "@vitest/coverage-v8": "^3.2.6",
    "@vue/test-utils": "^2.4.6",
    "cross-env": "^7.0.3",
    "happy-dom": "^15.11.0",
    "ioredis": "^5.6.0",
    "pg": "^8.13.0",
    "playwright-core": "^1.49.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.6",
    "vue-tsc": "^3.3.11",
    "workbox-precaching": "^7.4.1"
  }
}
