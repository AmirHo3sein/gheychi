NUXT_PUBLIC_API_BASE=http://localhost:3002/api
NUXT_PUBLIC_VAPID_PUBLIC_KEY=
# Browser crash reporting (app/plugins/sentry.client.ts). Empty = Sentry is never
# initialized at all, which is what local dev and CI want; a real DSN turns it on with no
# rebuild, since this is a runtimeConfig value rather than a build-time inline. A DSN is a
# public ingestion key, not a secret -- it ships to the browser by design.
NUXT_PUBLIC_SENTRY_DSN=
# Base URL for the <loc> entries in the hand-rolled sitemap routes (server/utils/sitemap-index.ts,
# server/handlers/sitemap-*-page.ts) -- the sitemap protocol requires fully-qualified URLs.
# In production this must be the real https://gheychi.co, not this localhost default (see
# the root .env.example, which is what docker-compose.prod.yml's user-app service actually reads).
NUXT_PUBLIC_SITE_URL=http://localhost:3003

# Legal operator identity, rendered on /terms and /privacy. Leave a value empty and the
# line that uses it is left out of the page -- nothing is ever invented. Fill these in (with
# the text reviewed by a lawyer) before launch.
NUXT_PUBLIC_LEGAL_NAME=
NUXT_PUBLIC_LEGAL_EMAIL=
NUXT_PUBLIC_LEGAL_PHONE=
NUXT_PUBLIC_LEGAL_ADDRESS=
NUXT_PUBLIC_LEGAL_REGISTRATION=
# Map tiles. Empty = OpenStreetMap standard tiles (light-use policy only -- not for real
# traffic). A custom URL must be https and contain {z}/{x}/{y}; also add its host to the CSP
# img-src. Attribution is HTML shown on the map; keep the provider's required credit here.
NUXT_PUBLIC_MAP_TILE_URL=
NUXT_PUBLIC_MAP_TILE_ATTRIBUTION=
