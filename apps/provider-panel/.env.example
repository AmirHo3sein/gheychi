VITE_API_BASE=http://localhost:3002/api
# The customer-facing user-app's own public base URL -- used only to build the shareable
# public salon link/QR shown on the salon-settings screen (gheychi.co/salons/<handle> in
# production), never called from this app. See docs/deployment/DEPLOY.md for the matching
# production repository variable.
VITE_CUSTOMER_APP_BASE=http://localhost:3003

# Browser crash reporting -- empty disables it entirely (see src/utils/error-reporting.ts).
# Baked into the bundle at build time; a DSN is a public ingestion key, not a secret.
VITE_SENTRY_DSN=
