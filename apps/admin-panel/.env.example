VITE_API_BASE=http://localhost:3002/api

# Browser crash reporting -- empty disables it entirely (see src/utils/error-reporting.ts).
# Baked into the bundle at build time; a DSN is a public ingestion key, not a secret.
VITE_SENTRY_DSN=

# Salon-approval map preview tile server (defaults to OpenStreetMap's). Changing provider is
# configuration plus a CSP img-src line, not a code change.
VITE_MAP_TILE_URL=
VITE_MAP_TILE_ATTRIBUTION=
