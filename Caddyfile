{
	email {$ACME_EMAIL}
}

(security_headers) {
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		# Safe to set unconditionally: every site block below is HTTPS-only (Caddy's
		# automatic HTTPS already redirects any stray HTTP request), so there is no legit
		# plain-HTTP traffic this could break. No `preload` -- that requires submitting to
		# the browser preload list, a much harder-to-reverse commitment than this repo
		# needs to make as part of a routine hardening pass.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
}

# Every powerful browser feature denied by default -- user-app's own block below overrides
# just `geolocation`, the one feature this stack actually uses (its home page's
# near-me search, see app/pages/index.vue). No site here uses camera/microphone/payment/usb.
(permissions_policy_restrictive) {
	header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
}

(permissions_policy_user_app) {
	header Permissions-Policy "camera=(), microphone=(), geolocation=(self), payment=(), usb=()"
}

# Report-Only, not enforcing -- see docs/deployment/csp-proposal.md for the full research
# behind each directive (live-browser-verified for user-app; static/build-output analysis
# for the panels; api needs essentially none since it never serves HTML). All three send
# violation reports to the same collector (csp-report/csp-report.controller.ts) regardless
# of which site block triggered them -- report-uri POSTs are exempt from CORS, so a
# cross-origin target here is fine. STORAGE_PROVIDER=local in production (confirmed on the
# live host), so img-src does not need a separate S3 host -- api.gheychi.co already covers
# /uploads/*.
(csp_user_app) {
	header Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://api.gheychi.co https://*.basemaps.cartocdn.com; font-src 'self'; connect-src 'self' https://api.gheychi.co; worker-src 'self'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'; report-uri https://api.gheychi.co/api/csp-report"
}

(csp_panel) {
	header Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://api.gheychi.co; font-src 'self'; connect-src 'self' https://api.gheychi.co; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'; report-uri https://api.gheychi.co/api/csp-report"
}

(csp_api) {
	header Content-Security-Policy-Report-Only "default-src 'none'; frame-ancestors 'none'; base-uri 'none'; report-uri https://api.gheychi.co/api/csp-report"
}

{$DOMAIN_APEX} {
	import security_headers
	import permissions_policy_user_app
	import csp_user_app
	reverse_proxy user-app:3003
}

# www is an alias, not a second copy of the site -- serving both identically lets Google
# index the same content under two hosts with no canonical signal between them (the
# customer app's own canonical/OG URLs are built from the actual request's Host header via
# useRequestURL(), so each host would self-referentially "confirm" itself as canonical).
# A 301 here is the one place that actually resolves that instead of leaving it to chance.
www.{$DOMAIN_APEX} {
	import security_headers
	import permissions_policy_restrictive
	redir https://{$DOMAIN_APEX}{uri} permanent
}

{$DOMAIN_API} {
	import security_headers
	import permissions_policy_restrictive
	import csp_api
	reverse_proxy api:3002
}

{$DOMAIN_PANEL} {
	import security_headers
	import permissions_policy_restrictive
	import csp_panel
	reverse_proxy provider-panel:80
}

{$DOMAIN_ADMIN} {
	import security_headers
	import permissions_policy_restrictive
	import csp_panel
	reverse_proxy admin-panel:80
}
