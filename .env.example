PORT=3002
DB_HOST=localhost
DB_PORT=5544
DB_USER=gheychi
DB_PASS=gheychi
DB_NAME=gheychi
REDIS_HOST=localhost
REDIS_PORT=6381
JWT_SECRET=dev-secret-change-me
SMS_PROVIDER=console
KAVENEGAR_API_KEY=
# RENAMED WITH THE PROJECT (was arayeshgah-otp). This name must match a template
# REGISTERED WITH KAVENEGAR -- it is their identifier, not ours. If the template on the
# Kavenegar side is still called arayeshgah-otp, OTP sends fail and nobody can log in.
# Re-register (or rename) it there before deploying with this value.
KAVENEGAR_OTP_TEMPLATE=gheychi-otp
PAYMENT_GATEWAY=mock
ZARINPAL_MERCHANT_ID=
# Personal access token from the Zarinpal panel -- required only when PAYMENT_GATEWAY=zarinpal (refund API auth)
ZARINPAL_ACCESS_TOKEN=
APP_BASE_URL=http://localhost:3002
FRONTEND_BASE_URL=http://localhost:3003
PROVIDER_APP_BASE_URL=http://localhost:3004
ADMIN_APP_BASE_URL=http://localhost:3005
PUSH_PROVIDER=console
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@gheychi.ir
# Admin phone(s) for critical money alerts (SMS via the configured SMS provider),
# comma-separated. Empty = SMS alerts disabled; in-app admin notifications are always on.
ALERT_ADMIN_PHONE=
# Global ceiling on alert SMS per hour (circuit breaker for mass incidents).
ALERT_SMS_HOURLY_CAP=30
NUXT_PUBLIC_NESHAN_API_KEY=
NUXT_PUBLIC_VAPID_PUBLIC_KEY=
STORAGE_PROVIDER=local
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
# RENAMED WITH THE PROJECT (was arayeshgah.ir). These must be domains you actually own and
# have pointed at the host: Caddy requests TLS certificates for them on startup, so an
# unregistered domain means production does not come up. Verify gheychi.ir is registered
# and its DNS resolves before deploying.
DOMAIN_APEX=gheychi.ir
DOMAIN_API=api.gheychi.ir
DOMAIN_PANEL=panel.gheychi.ir
DOMAIN_ADMIN=admin.gheychi.ir
ACME_EMAIL=admin@gheychi.ir
