PORT=3002
DB_HOST=localhost
DB_PORT=5544
DB_USER=gheychi
DB_PASS=gheychi
DB_NAME=gheychi
REDIS_HOST=localhost
REDIS_PORT=6381
JWT_SECRET=dev-secret-change-me
SMS_PROVIDER=console
KAVENEGAR_API_KEY=
# RENAMED WITH THE PROJECT (was arayeshgah-otp). This name must match a template
# REGISTERED WITH KAVENEGAR -- it is their identifier, not ours. If the template on the
# Kavenegar side is still called arayeshgah-otp, OTP sends fail and nobody can log in.
# Re-register (or rename) it there before deploying with this value.
KAVENEGAR_OTP_TEMPLATE=gheychi-otp
# SMS_PROVIDER=payamakyab -- a SOAP (.asmx) panel, hand-rolled request/response in
# payamakyab-sms.provider.ts (no SOAP client dependency). SENDER is the registered line
# number (e.g. a short code), not a phone number.
PAYAMAKYAB_USERNAME=
PAYAMAKYAB_PASSWORD=
PAYAMAKYAB_SENDER=
PAYMENT_GATEWAY=mock
ZARINPAL_MERCHANT_ID=
# Personal access token from the Zarinpal panel -- required only when PAYMENT_GATEWAY=zarinpal (refund API auth)
ZARINPAL_ACCESS_TOKEN=
APP_BASE_URL=http://localhost:3002
FRONTEND_BASE_URL=http://localhost:3003
PROVIDER_APP_BASE_URL=http://localhost:3004
ADMIN_APP_BASE_URL=http://localhost:3005
PUSH_PROVIDER=console
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@gheychi.co
# Read by the user-app container at runtime (docker-compose.prod.yml's user-app service
# shares this same root .env, not apps/user-app/.env.example) -- previously missing here
# entirely, which meant a real deploy following only this file would leave user-app
# silently defaulting to its dev fallbacks (http://localhost:3002/api,
# http://localhost:3003) in production: broken API calls and a sitemap full of localhost
# URLs. Must match FRONTEND_BASE_URL/APP_BASE_URL above, not duplicate a separate value.
NUXT_PUBLIC_API_BASE=http://localhost:3002/api
NUXT_PUBLIC_SITE_URL=http://localhost:3003
# Admin phone(s) for critical money alerts (SMS via the configured SMS provider),
# comma-separated. Empty = SMS alerts disabled; in-app admin notifications are always on.
ALERT_ADMIN_PHONE=
# Global ceiling on alert SMS per hour (circuit breaker for mass incidents).
ALERT_SMS_HOURLY_CAP=30
# Shared secret docker/backup/backup.sh sends as the `x-backup-report-secret` header on
# POST /api/internal/backup-report (apps/api/src/backup-monitoring), and the api service
# checks it against (constant-time comparison, see BackupReportSecretGuard). Both the
# `api` and `backup` services read this from this same root .env (docker-compose.prod.yml
# gives both `env_file: .env`) -- it must be set to the SAME value for both, or every
# backup report will be rejected with 401. This is the real access control for that
# endpoint, not just defense-in-depth: Caddy's reverse_proxy for {$DOMAIN_API} has no
# path restriction, so the route is reachable from the public internet like any other.
# Operator-generated, e.g.: openssl rand -hex 32
# Leave empty in local dev -- backup.sh treats an unset secret as "reporting disabled"
# and simply skips the report (logged), without failing the backup itself.
BACKUP_REPORT_SECRET=
# Grafana's initial admin login (docker-compose.prod.yml's `grafana` service). Grafana has
# no public route -- see DEPLOY.md's "Observability" section for SSH-tunnel access.
# Operator-generated, e.g.: openssl rand -hex 16. Required in production (Grafana refuses
# a blank admin password); local dev never runs this container at all.
GRAFANA_ADMIN_PASSWORD=
# ERROR_TRACKING_PROVIDER=sentry (with SENTRY_DSN set below) switches error capture from
# structured-JSON-to-Logger to a real Sentry account. Blank/unset = logger-only, the
# existing default -- see apps/api/src/error-tracking/error-tracking.module.ts.
ERROR_TRACKING_PROVIDER=
SENTRY_DSN=
NUXT_PUBLIC_NESHAN_API_KEY=
NUXT_PUBLIC_VAPID_PUBLIC_KEY=
STORAGE_PROVIDER=local
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
# These must be domains you actually own and have pointed at the host: Caddy requests TLS
# certificates for them on startup, so an unregistered domain (or DNS that hasn't
# propagated yet) means production does not come up. Verify gheychi.co's DNS resolves to
# this host before deploying -- see docs/deployment/DEPLOY.md.
DOMAIN_APEX=gheychi.co
DOMAIN_API=api.gheychi.co
DOMAIN_PANEL=panel.gheychi.co
DOMAIN_ADMIN=admin.gheychi.co
ACME_EMAIL=admin@gheychi.co
# Deploy identity, exposed publicly at GET /version -- deliberately NOT listed here as
# operator-set .env values. APP_VERSION/GIT_SHA/BUILD_TIMESTAMP are baked into the api
# image at build time (Dockerfile ARG -> ENV, set by CI from the release tag/commit/build
# time -- see apps/api/Dockerfile and .github/workflows/ci.yml). If these were also
# present here, docker-compose.prod.yml's `env_file: .env` for the api service would pass
# them as empty strings and silently override the real baked-in values with blanks --
# the exact same shadowing bug this codebase already hit once with user-app's PORT. Leave
# them out of your real deploy .env entirely; the Dockerfile's baked ENV already covers
# it, and local `pnpm dev` falls back to 'dev'/'unknown'/null with nothing set here.
# Optional: posts a release summary to Telegram after a manual production deploy (run by
# hand: `pnpm --filter @gheychi/api notify-telegram-release -- --version vX.Y.Z --from
# <ref> --to <ref>`). A missing/disabled config is never an error -- the script always
# exits 0 either way, see scripts/notify-telegram-release.ts. Get a bot token from
# @BotFather; TELEGRAM_CHAT_ID is the numeric id of the channel/group/user to post to.
TELEGRAM_RELEASE_NOTIFICATIONS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
